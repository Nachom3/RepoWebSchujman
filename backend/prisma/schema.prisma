generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERADOR
}

enum ClientStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDIENTE
  APROBADA
  COMPLETADA
  CANCELADA
}

enum TruckStatus {
  DISPONIBLE
  EN_RECORRIDO
}

enum MovementTipo {
  DEBITO
  CREDITO
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id           Int      @id @default(autoincrement())
  cuit         String   @unique
  razonSocial  String
  direccion    String?
  telefono     String?
  email        String?
  contacto     String?
  condicionIVA String?
  saldo        Float    @default(0)
  status       ClientStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movements      CuentaCorrienteMovimiento[]
  orders         Order[]
  portalSessions PortalSession[]
}

model CuentaCorrienteMovimiento {
  id        Int          @id @default(autoincrement())
  tipo      MovementTipo @default(DEBITO)
  monto     Float
  fecha     DateTime     @default(now())
  referencia String?
  clientId  Int
  client    Client       @relation(fields: [clientId], references: [id])
}

model Formula {
  id                   Int               @id @default(autoincrement())
  name                 String
  recipe               String?
  pricePerCubicMeter   Float             @default(0)
  orders               Order[]
  materials            FormulaMaterial[]
}

model Order {
  id           Int         @id @default(autoincrement())
  clientId     Int
  formulaId    Int
  truckId      Int?
  quantity     Float
  priceSnapshot Float?
  status       OrderStatus @default(PENDIENTE)
  createdAt    DateTime    @default(now())
  deliveryDate DateTime?
  scheduledDate DateTime?
  completedAt  DateTime?
  obraAddress  String?
  client       Client      @relation(fields: [clientId], references: [id])
  formula      Formula     @relation(fields: [formulaId], references: [id])
  truck        Truck?      @relation(fields: [truckId], references: [id])
}

model SiloStock {
  id        Int               @id @default(autoincrement())
  material  String
  quantity  Float
  unit      String
  alertMin  Float             @default(0)
  materials FormulaMaterial[]
}

model Truck {
  id       Int         @id @default(autoincrement())
  patente  String      @unique
  capacity Float
  status   TruckStatus @default(DISPONIBLE)
  orders   Order[]
}

model FormulaMaterial {
  id              Int       @id @default(autoincrement())
  formulaId       Int
  siloStockId     Int
  kgPerCubicMeter Float
  formula         Formula   @relation(fields: [formulaId], references: [id])
  siloStock       SiloStock @relation(fields: [siloStockId], references: [id])

  @@unique([formulaId, siloStockId])
}

model PortalSession {
  id        Int      @id @default(autoincrement())
  clientId  Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  client    Client   @relation(fields: [clientId], references: [id])
}
